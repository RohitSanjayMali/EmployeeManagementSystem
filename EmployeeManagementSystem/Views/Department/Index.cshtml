@model IEnumerable<Department>
@{
    ViewData["Title"] = "Departments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Departments</h4>
        <p class="text-muted small mb-0">Manage all departments</p>
    </div>
    <a href="/Department/Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Add Department
    </a>
</div>

<div class="row g-4">
    @foreach (var dept in Model)
    {
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="fw-bold mb-1">@dept.Name</h5>
                            <p class="text-muted small mb-2">@dept.Description</p>
                            <span class="badge bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-people me-1"></i>@dept.Employees.Count Employees
                            </span>
                        </div>
                        <div class="p-2 rounded-3" style="background:#e3f2fd">
                            <i class="bi bi-building fs-4 text-primary"></i>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <a href="/Department/Edit/@dept.Id" class="btn btn-sm btn-outline-warning">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <button onclick="deleteDept(@dept.Id, '@dept.Name')"
                                class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center py-4">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-1 mb-3 d-block"></i>
                <p>Delete department <strong id="deptName"></strong>?</p>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDelete">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let deleteId = null;

        function deleteDept(id, name) {
            deleteId = id;
            document.getElementById('deptName').textContent = name;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }

        document.getElementById('confirmDelete').addEventListener('click', function () {
            $.ajax({
                url: '/Department/Delete/' + deleteId,
                type: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (res) {
                    if (res.success) location.reload();
                }
            });
        });
    </script>
    @Html.AntiForgeryToken()
}