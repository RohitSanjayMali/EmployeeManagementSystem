@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Stats Cards -->
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="p-3 rounded-3" style="background:#e3f2fd">
                    <i class="bi bi-people-fill fs-3 text-primary"></i>
                </div>
                <div>
                    <div class="text-muted small">Total Employees</div>
                    <div class="fs-3 fw-bold">@Model.TotalEmployees</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="p-3 rounded-3" style="background:#e8f5e9">
                    <i class="bi bi-person-check-fill fs-3 text-success"></i>
                </div>
                <div>
                    <div class="text-muted small">Active Employees</div>
                    <div class="fs-3 fw-bold">@Model.ActiveEmployees</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="p-3 rounded-3" style="background:#fff3e0">
                    <i class="bi bi-building fs-3 text-warning"></i>
                </div>
                <div>
                    <div class="text-muted small">Departments</div>
                    <div class="fs-3 fw-bold">@Model.TotalDepartments</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="p-3 rounded-3" style="background:#fce4ec">
                    <i class="bi bi-currency-rupee fs-3 text-danger"></i>
                </div>
                <div>
                    <div class="text-muted small">Total Salary</div>
                    <div class="fs-3 fw-bold">₹@Model.TotalSalary.ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Chart -->
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white fw-semibold">
                <i class="bi bi-bar-chart-fill me-2 text-primary"></i>Employees by Department
            </div>
            <div class="card-body">
                <canvas id="deptChart" height="100"></canvas>
            </div>
        </div>
    </div>

    <!-- Recent Employees -->
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header bg-white fw-semibold">
                <i class="bi bi-clock-history me-2 text-primary"></i>Recent Employees
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @foreach (var emp in Model.RecentEmployees)
                    {
                        <li class="list-group-item d-flex align-items-center gap-2">
                            @if (!string.IsNullOrEmpty(emp.ProfileImage))
                            {
                                <img src="@emp.ProfileImage" class="rounded-circle"
                                     width="35" height="35" style="object-fit:cover" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center text-white fw-bold"
                                     style="width:35px;height:35px;font-size:14px">
                                    @emp.FirstName[0]
                                </div>
                            }
                            <div>
                                <div class="fw-semibold small">@emp.FullName</div>
                                <div class="text-muted" style="font-size:11px">@emp.Department?.Name</div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script>
        const ctx = document.getElementById('deptChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                    Model.DepartmentStats.Select(d => d.DepartmentName))),
            datasets: [{
                label: 'Employees',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                        Model.DepartmentStats.Select(d => d.EmployeeCount))),
                backgroundColor: ['#1e3a5f','#2d6a9f','#28a745','#ffc107','#dc3545'],
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
    });
</script>
}