@model Employee
@{
    ViewData["Title"] = "Employee Details";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-4 mb-4">
                    @if (!string.IsNullOrEmpty(Model.ProfileImage))
                    {
                        <img src="@Model.ProfileImage" class="rounded-circle"
                             width="80" height="80" style="object-fit:cover" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center text-white fw-bold"
                             style="width:80px;height:80px;font-size:28px">
                            @Model.FirstName[0]
                        </div>
                    }
                    <div>
                        <h4 class="mb-0 fw-bold">@Model.FullName</h4>
                        <p class="text-muted mb-1">@Model.Position</p>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small mb-1">
                                <i class="bi bi-envelope me-1"></i>Email
                            </div>
                            <div class="fw-semibold">@Model.Email</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small mb-1">
                                <i class="bi bi-phone me-1"></i>Phone
                            </div>
                            <div class="fw-semibold">@Model.Phone</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small mb-1">
                                <i class="bi bi-building me-1"></i>Department
                            </div>
                            <div class="fw-semibold">@Model.Department?.Name</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small mb-1">
                                <i class="bi bi-currency-rupee me-1"></i>Salary
                            </div>
                            <div class="fw-semibold">₹@Model.Salary.ToString("N0")</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small mb-1">
                                <i class="bi bi-calendar me-1"></i>Joining Date
                            </div>
                            <div class="fw-semibold">@Model.JoiningDate.ToString("dd MMM yyyy")</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <a href="/Employee/Edit/@Model.Id" class="btn btn-warning">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                    <a href="/Employee/Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Back
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>